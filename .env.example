# ============================================================
#  Minivers — environment variables (copy to .env and edit)
# ============================================================
#
#  • Every value here can be overridden. Defaults are baked into
#    settings.py so a missing .env still works (SQLite fallback,
#    DEBUG off, WhiteNoise on).
#  • The Django web container reads this file via python-dotenv,
#    which is loaded at the top of minivers/settings.py.
#  • docker-compose.yml exposes these to the containers under
#    the same names.
#  • .env is git-ignored — NEVER commit the real file or its
#    secrets.
#
#  After editing, restart the stack:
#      docker compose up -d
# ============================================================


# ------------------------------------------------------------
# Django
# ------------------------------------------------------------

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=django-insecure-change-me-in-production

# MUST stay false in production. Controls both debug pages and the
# dev-server auto-reload behaviour. Defaults to false even without
# a .env file — turn it on explicitly in local dev only.
DJANGO_DEBUG=false

# Comma-separated list of hostnames the app will serve.
# Use "*" only in development. Examples:
#   localhost,127.0.0.1,minivers.local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to false for plain local development without Docker: static
# files are then served by runserver with un-hashed names and no
# collectstatic is needed. Leave unset / true in production.
# DJANGO_WHITENOISE=true


# ------------------------------------------------------------
# Web server (port exposed on the HOST machine)
# ------------------------------------------------------------

# Port the app is reachable on from your browser.
# Inside the container gunicorn always listens on 8000.
APP_PORT=8000

# Number of gunicorn worker processes. Rule of thumb: 2 x CPUs + 1.
GUNICORN_WORKERS=3


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

# Engine: "postgres" (production / docker) or "sqlite" (no-docker local dev).
DB_ENGINE=postgres

# Database name (Postgres) OR file path (SQLite).
DB_NAME=minivers

# Postgres user / password. Ignored when DB_ENGINE=sqlite.
DB_USER=minivers
DB_PASSWORD=minivers

# Host + port the APP connects to. With docker compose this is the service
# name "db" on port 5432 — Postgres always listens on 5432 inside the compose
# network, so leave DB_PORT alone unless you point at an external database.
DB_HOST=db
DB_PORT=5432

# Port Postgres is exposed on YOUR machine, for psql / a GUI client.
# This one is free to change (e.g. 47411 if 5432 is already taken locally).
# It has no effect on how the app reaches the database.
DB_HOST_PORT=5432


# ------------------------------------------------------------
# Paths (usually left alone — see docker-compose.yml)
# ------------------------------------------------------------

# Where collectstatic puts files and where uploads land. The compose file
# pins these to /var/www/static and /var/www/media, OUTSIDE the bind-mounted
# source tree (the container user cannot write into /app).
# STATIC_ROOT=/var/www/static
# MEDIA_ROOT=/var/www/media
